<view class="page">
  <view class="page-header">
    <view class="page-title">今天吃什么？</view>
    <view class="page-subtitle">选择想吃的菜品，提交给厨房</view>
  </view>

  <view wx:for="{{recipes}}" wx:key="_id">
    <recipe-tile
      recipe="{{item}}"
      selected="{{selectedIds.indexOf(item._id) >= 0}}"
      quantity="{{selectedRecipes[item._id].quantity || 1}}"
      note="{{selectedRecipes[item._id].note || ''}}"
      bind:toggle="onToggleRecipe"
      bind:quantitychange="onQuantityChange"
      bind:notechange="onNoteChange" />
  </view>

  <view wx:if="{{recipes.length === 0}}" class="empty-state">
    <view class="empty-icon">🍽️</view>
    <text class="empty-text">暂无菜品，请先添加菜谱</text>
  </view>

  <!-- Bottom Cart Bar -->
  <view wx:if="{{totalCount > 0}}" class="cart-bar">
    <!-- Cart Panel (expandable) -->
    <view wx:if="{{showCart}}" class="cart-panel">
      <view class="cart-panel-header">
        <text class="cart-panel-title">已选菜品</text>
        <view class="cart-panel-clear" bindtap="onClearAll">
          <text class="clear-icon">🗑️</text>
          <text class="clear-text">清空</text>
        </view>
      </view>
      <scroll-view class="cart-panel-list" scroll-y>
        <view wx:for="{{cartItems}}" wx:key="recipeId" class="cart-panel-item">
          <view class="cart-panel-item-left">
            <text class="cart-panel-item-name">{{item.name}}</text>
          </view>
          <view class="cart-panel-item-right">
            <view class="qty-btn-circle" bindtap="onCartDecrease" data-id="{{item.recipeId}}">
              <text class="qty-btn-icon">-</text>
            </view>
            <text class="qty-num">{{item.quantity}}</text>
            <view class="qty-btn-circle" bindtap="onCartIncrease" data-id="{{item.recipeId}}">
              <text class="qty-btn-icon">+</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- Bottom Action Bar (connected to panel) -->
    <view class="cart-action-bar" bindtap="onToggleCart" style="{{showCart ? 'border-radius: 0 0 24rpx 24rpx; margin-top: 0;' : ''}}">
      <view class="cart-action-left">
        <view class="cart-icon-wrap">
          <text class="cart-icon">🛒</text>
          <view class="cart-badge">{{totalCount}}</view>
        </view>
        <view class="cart-summary">
          <text class="cart-summary-count">共{{totalCount}}道菜</text>
          <text class="cart-summary-time" wx:if="{{totalMinutes > 0}}">约{{totalMinutes}}分钟</text>
        </view>
      </view>
      <button class="cart-submit-btn" catchtap="onSubmitOrder">提交订单</button>
    </view>
  </view>

  <!-- Cart Mask -->
  <view wx:if="{{showCart}}" class="cart-mask" bindtap="onHideCart"></view>
</view>
