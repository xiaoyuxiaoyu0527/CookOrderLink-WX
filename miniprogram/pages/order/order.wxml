<view class="page">
  <view class="page-header">
    <view class="page-title">今天吃什么？</view>
    <view class="page-subtitle">选择想吃的菜品，提交给厨房</view>
  </view>

  <view wx:for="{{recipes}}" wx:key="_id">
    <recipe-tile
      recipe="{{item}}"
      selected="{{selectedIds.indexOf(item._id) >= 0}}"
      quantity="{{selectedRecipes[item._id].quantity || 1}}"
      note="{{selectedRecipes[item._id].note || ''}}"
      bind:toggle="onToggleRecipe"
      bind:quantitychange="onQuantityChange"
      bind:notechange="onNoteChange" />
  </view>

  <view wx:if="{{recipes.length === 0}}" class="empty-state">
    <view class="empty-icon">🍽️</view>
    <text class="empty-text">暂无菜品，请先添加菜谱</text>
  </view>

  <!-- Bottom Bar -->
  <view wx:if="{{totalCount > 0}}" class="bottom-bar" bindtap="onShowCart">
    <view class="bar-info">
      <text class="bar-count">已选 {{totalCount}} 道菜</text>
      <text class="bar-time" wx:if="{{totalMinutes > 0}}">约 {{totalMinutes}} 分钟</text>
    </view>
    <button class="btn-primary" catchtap="onSubmitOrder">提交订单</button>
  </view>

  <!-- Cart Sheet -->
  <view wx:if="{{showCart}}" class="cart-mask" bindtap="onHideCart">
    <view class="cart-sheet" catchtap="noop">
      <view class="cart-header">
        <text class="cart-title">已选菜品</text>
        <view class="cart-clear" bindtap="onClearAll">清空</view>
      </view>
      <scroll-view class="cart-list" scroll-y>
        <view wx:for="{{cartItems}}" wx:key="recipeId" class="cart-item">
          <view class="cart-item-left">
            <view class="cart-item-info">
              <text class="cart-item-name">{{item.name}}</text>
              <text wx:if="{{item.note}}" class="cart-item-note">{{item.note}}</text>
            </view>
          </view>
          <view class="cart-item-actions">
            <view class="cart-qty-btn" bindtap="onCartDecrease" data-id="{{item.recipeId}}">-</view>
            <text class="cart-qty-value">{{item.quantity}}</text>
            <view class="cart-qty-btn" bindtap="onCartIncrease" data-id="{{item.recipeId}}">+</view>
          </view>
        </view>
      </scroll-view>
      <view class="cart-footer">
        <text class="cart-total">共 {{totalCount}} 道菜</text>
        <button class="btn-primary" bindtap="onSubmitFromCart">提交订单</button>
      </view>
    </view>
  </view>
</view>
