.page {
  background: var(--color-canvas);
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.page-header {
  padding: 32rpx 32rpx 16rpx;
  background: var(--color-canvas);
}
.page-title {
  font: var(--font-display);
  color: var(--color-ink);
  margin-bottom: 8rpx;
}
.page-subtitle {
  font: var(--font-caption);
  color: var(--color-ink-muted);
}

.empty-state {
  text-align: center;
  padding: 200rpx 48rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font: var(--font-body);
  color: var(--color-ink-muted);
}

/* Cart Mask */
.cart-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 199;
}

/* Cart Bar Container */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  padding: 0 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

/* Cart Panel (expandable list) */
.cart-panel {
  background: var(--color-canvas-card);
  border-radius: 24rpx 24rpx 0 0;
  max-height: 500rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 0;
}

.cart-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--color-hairline);
}

.cart-panel-title {
  font: var(--font-body-strong);
  color: var(--color-ink);
}

.cart-panel-clear {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.clear-icon {
  font-size: 28rpx;
}

.clear-text {
  font: var(--font-caption);
  color: var(--color-danger);
}

.cart-panel-list {
  flex: 1;
  max-height: 400rpx;
  padding: 0 32rpx;
}

.cart-panel-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-hairline);
}

.cart-panel-item:last-child {
  border-bottom: none;
}

.cart-item-name-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.cart-item-name-text {
  font: var(--font-body);
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.cart-item-qty-wrap {
  display: flex;
  align-items: center;
  width: 170rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  margin-right: 56rpx;
  justify-content: space-between;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-canvas-warm);
  border: 1rpx solid var(--color-hairline);
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty-btn text {
  font-size: 28rpx;
  color: var(--color-ink);
  font-weight: 600;
  line-height: 1;
}

.qty-btn:active {
  background: var(--color-hairline);
}

.qty-value {
  font: var(--font-body-strong);
  color: var(--color-ink);
  min-width: 40rpx;
  text-align: center;
}

/* Bottom Action Bar */
.cart-action-bar {
  display: flex;
  align-items: center;
  background: var(--color-canvas-card);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: border-radius 0.2s ease, margin-top 0.2s ease;
}

.cart-action-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.cart-icon-wrap {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-icon {
  font-size: 32rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: var(--color-danger);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.cart-summary {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.cart-summary-count {
  font: var(--font-body-medium);
  color: var(--color-ink);
}

.cart-summary-time {
  font: var(--font-tiny);
  color: var(--color-ink-muted);
}

.cart-submit-btn {
  flex: 1;
  background: var(--color-primary);
  color: #ffffff;
  font: var(--font-body-medium);
  border-radius: var(--radius-pill);
  padding: 20rpx 0;
  text-align: center;
  border: none;
  margin-left: 24rpx;
  font-size: 28rpx;
}

.cart-submit-btn:active {
  opacity: 0.9;
}
