.page {
  background: var(--color-canvas);
  min-height: 100vh;
  padding-bottom: 180rpx;
}

.page-header {
  padding: 32rpx 32rpx 16rpx;
  background: var(--color-canvas);
}
.page-title {
  font: var(--font-display);
  color: var(--color-ink);
  margin-bottom: 8rpx;
}
.page-subtitle {
  font: var(--font-caption);
  color: var(--color-ink-muted);
}

.empty-state {
  text-align: center;
  padding: 200rpx 48rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font: var(--font-body);
  color: var(--color-ink-muted);
}

/* Bottom Bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-canvas-card);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(61, 44, 30, 0.08);
  z-index: 100;
}

.bar-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.bar-count {
  font: var(--font-body-medium);
  color: var(--color-ink);
}
.bar-time {
  font: var(--font-tiny);
  color: var(--color-ink-muted);
}

/* Cart Sheet */
.cart-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.cart-sheet {
  width: 100%;
  max-height: 70vh;
  background: var(--color-canvas-card);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-hairline);
}

.cart-title {
  font: var(--font-title);
  color: var(--color-ink);
}

.cart-clear {
  font: var(--font-caption-medium);
  color: var(--color-danger);
}

.cart-list {
  flex: 1;
  max-height: 50vh;
  padding: 0 32rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-hairline);
}

.cart-item-left {
  flex: 1;
  min-width: 0;
}

.cart-item-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cart-item-name {
  font: var(--font-body-medium);
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-item-qty {
  font: var(--font-caption);
  color: var(--color-primary);
  background: rgba(224, 122, 58, 0.1);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  flex-shrink: 0;
}

.cart-item-note {
  font: var(--font-tiny);
  color: var(--color-ink-muted);
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 0;
}

/* Cart +/- buttons */
.cart-item-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}
.cart-qty-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-canvas-warm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-ink);
  font-weight: 500;
}
.cart-qty-btn:active {
  background: var(--color-hairline);
}
.cart-qty-value {
  font: var(--font-body-medium);
  color: var(--color-ink);
  min-width: 32rpx;
  text-align: center;
}

.cart-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-hairline);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-total {
  font: var(--font-body-medium);
  color: var(--color-ink);
}
