.page {
  background: var(--color-canvas);
  min-height: 100vh;
  padding-bottom: 32rpx;
}

.tabs {
  display: flex;
  margin: 0 32rpx;
  background: var(--color-canvas-warm);
  border-radius: var(--radius-pill);
  padding: 6rpx;
  gap: 4rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font: var(--font-caption-medium);
  color: var(--color-ink-muted);
  border-radius: var(--radius-pill);
  transition: all 0.2s ease;
}
.tab.active {
  background: var(--color-canvas-card);
  color: var(--color-primary);
  box-shadow: 0 2rpx 8rpx rgba(61, 44, 30, 0.08);
}

.order-list {
  padding: 24rpx 32rpx;
}

.order-action {
  padding: 0 32rpx 16rpx;
  display: flex;
  justify-content: flex-end;
}

.empty-state {
  text-align: center;
  padding: 160rpx 48rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font: var(--font-body);
  color: var(--color-ink-muted);
}
