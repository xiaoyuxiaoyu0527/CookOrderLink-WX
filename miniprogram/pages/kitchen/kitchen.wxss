.page {
  background: var(--color-canvas);
  min-height: 100vh;
  padding-bottom: 48rpx;
}

/* ─── Kitchen Header ─── */
.kitchen-header {
  position: relative;
  overflow: hidden;
  padding: 48rpx 36rpx 40rpx;
}
.header-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(145deg, #e07a3a 0%, #c45d2a 50%, #a04820 100%);
  border-radius: 0 0 48rpx 48rpx;
}
.header-bg::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(circle at 80% 20%, rgba(255,255,255,0.15) 0%, transparent 50%);
}
.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.header-greeting {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.greeting-emoji {
  font-size: 56rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.15));
}
.greeting-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.greeting-title {
  font: 700 38rpx/1.2 'PingFang SC', system-ui, sans-serif;
  color: #ffffff;
  letter-spacing: 2rpx;
}
.greeting-sub {
  font: 400 24rpx/1.3 'PingFang SC', system-ui, sans-serif;
  color: rgba(255,255,255,0.75);
}
.header-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(10px);
  border-radius: 24rpx;
  padding: 16rpx 28rpx;
  min-width: 100rpx;
}
.stat-number {
  font: 700 44rpx/1 'PingFang SC', system-ui, sans-serif;
  color: #ffffff;
}
.stat-label {
  font: 500 20rpx/1.3 'PingFang SC', system-ui, sans-serif;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

/* ─── Tabs ─── */
.tabs-wrap {
  padding: 0 36rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}
.tabs {
  display: flex;
  background: var(--color-canvas-card);
  border-radius: 24rpx;
  padding: 8rpx;
  gap: 4rpx;
  box-shadow: 0 4rpx 24rpx rgba(61,44,30,0.08);
}
.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  text-align: center;
  padding: 20rpx 0;
  font: 500 26rpx/1.3 'PingFang SC', system-ui, sans-serif;
  color: var(--color-ink-muted);
  border-radius: 18rpx;
  transition: all 0.25s ease;
}
.tab.active {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(224,122,58,0.3);
}
.tab-badge {
  font: 600 20rpx/1 'PingFang SC', system-ui, sans-serif;
  background: rgba(224,122,58,0.12);
  color: var(--color-primary);
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}
.tab.active .tab-badge {
  background: rgba(255,255,255,0.25);
  color: #ffffff;
}

/* ─── Action Bar (Complete All) ─── */
.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 28rpx 36rpx 0;
  padding: 20rpx 28rpx;
  background: var(--color-canvas-card);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(61,44,30,0.05);
}
.action-bar-info {
  display: flex;
  align-items: center;
}
.action-bar-count {
  font: 400 24rpx/1.3 'PingFang SC', system-ui, sans-serif;
  color: var(--color-ink-muted);
}
.btn-complete-all {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, var(--color-success) 0%, #4a8a5b 100%);
  color: #ffffff;
  border-radius: 20rpx;
  padding: 14rpx 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(90,154,107,0.25);
}
.btn-complete-all:active {
  transform: scale(0.96);
  opacity: 0.9;
}
.complete-all-icon {
  font-size: 24rpx;
  font-weight: 700;
}
.complete-all-text {
  font: 500 24rpx/1.3 'PingFang SC', system-ui, sans-serif;
}

/* ─── Order List ─── */
.order-list {
  padding: 24rpx 36rpx;
}

.order-card-wrap {
  position: relative;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--color-canvas-card);
  box-shadow: 0 4rpx 20rpx rgba(61,44,30,0.06);
}
.order-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}
.order-accent-pending {
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
}
.order-accent-done {
  background: linear-gradient(180deg, var(--color-success) 0%, #4a8a5b 100%);
}
.order-accent-cancelled {
  background: linear-gradient(180deg, var(--color-ink-muted) 0%, #6b5a4a 100%);
}

/* Override order-card inside wrapper */
.order-card-wrap .order-card {
  background: transparent;
  box-shadow: none;
  border-radius: 0;
  margin-bottom: 0;
  padding-left: 40rpx;
}

/* ─── Order Actions ─── */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 0 36rpx 20rpx;
}
.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-radius: 18rpx;
  padding: 14rpx 28rpx;
  transition: all 0.2s ease;
}
.action-btn:active {
  transform: scale(0.95);
  opacity: 0.85;
}
.action-btn-done {
  background: rgba(90,154,107,0.1);
}
.action-btn-done .action-btn-icon {
  color: var(--color-success);
  font-size: 22rpx;
  font-weight: 700;
}
.action-btn-done .action-btn-text {
  font: 500 24rpx/1.3 'PingFang SC', system-ui, sans-serif;
  color: var(--color-success);
}
.action-btn-cancel {
  background: rgba(217,79,79,0.08);
}
.action-btn-cancel .action-btn-icon {
  color: var(--color-danger);
  font-size: 20rpx;
  font-weight: 600;
}
.action-btn-cancel .action-btn-text {
  font: 500 24rpx/1.3 'PingFang SC', system-ui, sans-serif;
  color: var(--color-danger);
}

/* ─── Cancel Reason Card ─── */
.cancel-reason-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 0 36rpx 20rpx;
  padding: 20rpx 24rpx;
  background: rgba(217,79,79,0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(217,79,79,0.1);
}
.cancel-reason-icon {
  font-size: 28rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
}
.cancel-reason-body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}
.cancel-reason-label {
  font: 500 20rpx/1.3 'PingFang SC', system-ui, sans-serif;
  color: var(--color-ink-muted);
}
.cancel-reason-text {
  font: 400 26rpx/1.5 'PingFang SC', system-ui, sans-serif;
  color: var(--color-danger);
  word-break: break-all;
}

/* ─── Empty State ─── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 80rpx;
}
.empty-illustration {
  margin-bottom: 40rpx;
}
.empty-plate {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--color-canvas-warm) 0%, #efe5d8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    inset 0 4rpx 12rpx rgba(61,44,30,0.06),
    0 8rpx 32rpx rgba(61,44,30,0.08);
  position: relative;
}
.empty-plate::after {
  content: '';
  position: absolute;
  top: 12rpx; left: 12rpx; right: 12rpx; bottom: 12rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(224,122,58,0.2);
}
.empty-emoji {
  font-size: 64rpx;
}
.empty-title {
  font: 600 32rpx/1.3 'PingFang SC', system-ui, sans-serif;
  color: var(--color-ink);
  margin-bottom: 12rpx;
}
.empty-sub {
  font: 400 26rpx/1.5 'PingFang SC', system-ui, sans-serif;
  color: var(--color-ink-muted);
}

/* ─── Cancel Modal ─── */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(44,30,18,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-content {
  background: var(--color-canvas-card);
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  width: 82%;
  box-shadow: 0 20rpx 60rpx rgba(44,30,18,0.2);
}
.modal-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}
.modal-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(217,79,79,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.modal-icon {
  font-size: 40rpx;
}
.modal-title {
  font: 700 34rpx/1.3 'PingFang SC', system-ui, sans-serif;
  color: var(--color-ink);
  margin-bottom: 8rpx;
}
.modal-desc {
  font: 400 24rpx/1.4 'PingFang SC', system-ui, sans-serif;
  color: var(--color-ink-muted);
}
.modal-textarea {
  border: 2rpx solid var(--color-hairline);
  border-radius: 20rpx;
  padding: 24rpx;
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: var(--color-ink);
  box-sizing: border-box;
  margin-bottom: 32rpx;
  background: var(--color-canvas-warm);
  transition: border-color 0.2s ease;
}
.modal-textarea:focus {
  border-color: var(--color-primary);
}
.modal-btns {
  display: flex;
  gap: 20rpx;
}
.btn-modal-back {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-canvas-warm);
  color: var(--color-ink-muted);
  font: 500 28rpx/1.3 'PingFang SC', system-ui, sans-serif;
  border-radius: 20rpx;
  padding: 24rpx 0;
}
.btn-modal-back:active {
  background: var(--color-hairline);
}
.btn-modal-confirm {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-danger) 0%, #c44040 100%);
  color: #ffffff;
  font: 500 28rpx/1.3 'PingFang SC', system-ui, sans-serif;
  border-radius: 20rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(217,79,79,0.25);
}
.btn-modal-confirm:active {
  transform: scale(0.97);
  opacity: 0.9;
}
