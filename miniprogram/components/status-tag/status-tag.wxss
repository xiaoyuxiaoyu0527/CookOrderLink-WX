.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  font: 500 20rpx/1.3 'PingFang SC', system-ui, sans-serif;
  letter-spacing: 1rpx;
}

.tag-pending {
  background: rgba(224,122,58,0.1);
  color: #d46a2e;
}

.tag-cooking {
  background: rgba(217,79,79,0.1);
  color: #c44040;
}

.tag-done {
  background: rgba(90,154,107,0.1);
  color: #4a8a5b;
}

.tag-cancelled {
  background: rgba(139,122,106,0.1);
  color: var(--color-ink-muted);
}
