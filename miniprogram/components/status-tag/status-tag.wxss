.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  font: var(--font-tiny);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.tag-pending {
  background: #fff3e0;
  color: #e8943a;
}

.tag-cooking {
  background: #fce4ec;
  color: #d94f4f;
}

.tag-done {
  background: #e8f5e9;
  color: #5a9a6b;
}

.tag-cancelled {
  background: var(--color-canvas-warm);
  color: var(--color-ink-muted);
}
