.order-card {
  padding: 28rpx 32rpx 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-time {
  font: 400 22rpx/1.3 'PingFang SC', system-ui, sans-serif;
  color: var(--color-ink-muted);
}

.header-arrow {
  font-size: 32rpx;
  color: var(--color-hairline);
  font-weight: 300;
}

.card-items {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.order-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 8rpx 0;
}

.item-arrow {
  font-size: 28rpx;
  color: var(--color-hairline);
  font-weight: 300;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.item-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
  margin-top: 12rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(224,122,58,0.2);
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.item-name {
  font: 500 30rpx/1.4 'PingFang SC', system-ui, sans-serif;
  color: var(--color-ink);
}

.item-note {
  font: 400 22rpx/1.4 'PingFang SC', system-ui, sans-serif;
  color: var(--color-ink-muted);
  padding-left: 4rpx;
}

.order-note {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-hairline);
  display: flex;
  gap: 12rpx;
  align-items: baseline;
}

.note-label {
  font: 500 22rpx/1.3 'PingFang SC', system-ui, sans-serif;
  color: var(--color-primary);
  flex-shrink: 0;
}

.note-text {
  font: 400 24rpx/1.5 'PingFang SC', system-ui, sans-serif;
  color: var(--color-ink-soft);
}
