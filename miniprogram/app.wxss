/* CookOrderLink — Warm Kitchen Design System */
page {
  /* Warm palette */
  --color-primary: #e07a3a;
  --color-primary-light: #f4a261;
  --color-primary-dark: #c45d2a;
  --color-ink: #3d2c1e;
  --color-ink-soft: #5c4a3a;
  --color-ink-muted: #8b7a6a;
  --color-canvas: #fdf8f3;
  --color-canvas-warm: #f7efe6;
  --color-canvas-card: #ffffff;
  --color-surface-dark: #2c1e12;
  --color-on-dark: #fdf8f3;
  --color-hairline: #e8ddd2;
  --color-danger: #d94f4f;
  --color-warning: #e8943a;
  --color-success: #5a9a6b;
  --color-overlay: rgba(44, 30, 18, 0.5);

  /* Typography */
  --font-display: 700 44rpx/1.2 'PingFang SC', system-ui, sans-serif;
  --font-title: 600 36rpx/1.3 'PingFang SC', system-ui, sans-serif;
  --font-body: 400 30rpx/1.6 'PingFang SC', system-ui, sans-serif;
  --font-body-medium: 500 30rpx/1.6 'PingFang SC', system-ui, sans-serif;
  --font-caption: 400 24rpx/1.4 'PingFang SC', system-ui, sans-serif;
  --font-caption-medium: 500 24rpx/1.4 'PingFang SC', system-ui, sans-serif;
  --font-tiny: 400 20rpx/1.3 'PingFang SC', system-ui, sans-serif;

  /* Radius */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 40rpx;
  --radius-pill: 9999rpx;

  /* Shadows */
  --shadow-card: 0 4rpx 20rpx rgba(61, 44, 30, 0.06);
  --shadow-card-hover: 0 8rpx 32rpx rgba(61, 44, 30, 0.1);
  --shadow-float: 0 12rpx 40rpx rgba(61, 44, 30, 0.12);

  font: var(--font-body);
  color: var(--color-ink);
  background: var(--color-canvas);
}

/* Global buttons */
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #ffffff;
  font: var(--font-body-medium);
  border-radius: var(--radius-pill);
  padding: 24rpx 48rpx;
  text-align: center;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(224, 122, 58, 0.3);
  letter-spacing: 2rpx;
}
.btn-primary:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(224, 122, 58, 0.2);
}

.btn-secondary {
  background: transparent;
  color: var(--color-primary);
  font: var(--font-body-medium);
  border-radius: var(--radius-pill);
  padding: 24rpx 48rpx;
  text-align: center;
  border: 2rpx solid var(--color-primary);
}
.btn-secondary:active {
  background: rgba(224, 122, 58, 0.08);
}

.btn-ghost {
  background: rgba(224, 122, 58, 0.08);
  color: var(--color-primary);
  font: var(--font-caption-medium);
  border-radius: var(--radius-pill);
  padding: 16rpx 32rpx;
  text-align: center;
  border: none;
}

.btn-danger {
  background: transparent;
  color: var(--color-danger);
  font: var(--font-body-medium);
  border-radius: var(--radius-pill);
  padding: 24rpx 48rpx;
  text-align: center;
  border: 2rpx solid var(--color-danger);
}

/* Card */
.card {
  background: var(--color-canvas-card);
  border-radius: var(--radius-lg);
  padding: 36rpx;
  box-shadow: var(--shadow-card);
}

/* Status colors */
.status-normal { color: var(--color-success); }
.status-expiring { color: var(--color-warning); }
.status-expired { color: var(--color-danger); }
.status-out-of-stock { color: var(--color-ink-muted); }
